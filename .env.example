# ---- Supabase (create a NEW project: Settings > API) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Stripe (test mode is fine) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# ---- App ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Leave empty = DEMO payments (checkout page + "Payment successful", no Stripe needed).
# Set to true to use real Stripe test payments (needs the Stripe keys above).
USE_STRIPE=
